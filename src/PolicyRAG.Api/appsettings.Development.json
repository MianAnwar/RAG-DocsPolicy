{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "policy_documents_dev",
    "VectorSize": 1536
  },
  
  "OpenAI": {
    "ApiKey": "your-openai-api-key-here",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o"
  },
  
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com",
    "ApiKey": "your-azure-openai-api-key-here",
    "EmbeddingDeployment": "text-embedding-3-small",
    "ChatDeployment": "gpt-4o"
  },
  
  "Chunking": {
    "MaxChunkSize": 512,
    "ChunkOverlap": 50,
    "MinChunkSize": 100
  },
  
  "Retrieval": {
    "DefaultTopK": 5,
    "ScoreThreshold": 0.7,
    "MmrDiversity": 0.3
  }
}
